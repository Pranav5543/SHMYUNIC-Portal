# Backend Application Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# PostgreSQL Managed Database Connection String
DATABASE_URL=postgresql://user:password@localhost:5432/shopmyuniform?schema=public

# JWT Session Authentication Key
JWT_SECRET=super-secret-jwt-key-change-in-production

# Google OAuth 2.0 Credentials (GCP Console Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Transactional SMTP Email Provider (SendGrid / Mailtrap)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password

# Payment Gateway (Stripe / Razorpay)
PAYMENT_GATEWAY_KEY=pk_test_your_key
PAYMENT_GATEWAY_SECRET=sk_test_your_secret

# Cloud Object Storage (AWS S3 / Google Cloud Storage)
STORAGE_BUCKET_NAME=shopmyuniform-assets
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
